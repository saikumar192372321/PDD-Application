# ============================================================
# .env.example — VSN Home Backend Configuration
# Copy this to .env and update with your actual values
# NEVER commit .env to version control!
# ============================================================

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=your_secure_password_here
DB_NAME=vsn_grocery

# API Configuration  
API_URL=https://yourdomain.com/vsn_grocery/
RAZORPAY_KEY_ID=rzp_live_YourActualKeyHere
RAZORPAY_KEY_SECRET=rzp_live_YourActualSecretHere

# CORS Configuration (whitelist your domains)
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Security
SESSION_TIMEOUT=1800
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Debug Mode (set to false in production)
DEBUG=false
LOG_FILE=/var/log/vsn_grocery.log
